{
	"name": "lesson-replay",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"build": "vite build",
		"verify:static": "node scripts/verify-static.mjs"
	},
	"dependencies": {
		"@lucide/svelte": "1.52.0",
		"bits-ui": "2.19.5",
		"cn": "0.4.0",
		"mediabunny": "1.66.0",
		"perfect-freehand": "1.2.2",
		"tailwind-variants": "3.3.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.4",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "16.5.0",
		"jsdom": "30.1.2",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "3.5.2",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"imports": {
		"#lib/sui/*": "./vendor/sui/src/lib/sui/*",
		"#lib/components/ui/*": "./vendor/sui/src/lib/components/ui/*",
		"#lib/hooks/*": "./vendor/sui/src/lib/hooks/*",
		"#lib/utils.js": "./vendor/sui/src/lib/utils.js",
		"#lib/replay/*": "./src/lib/replay/*"
	}
}
