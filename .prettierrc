{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"singleQuote": true,
	"trailingComma": "none",
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{ "files": ["*.svelte"], "options": { "parser": "svelte" } },
		{ "files": ["*.yml"], "options": { "useTabs": false, "tabWidth": 2 } }
	]
}
